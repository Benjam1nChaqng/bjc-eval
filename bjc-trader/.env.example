# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Create Alpaca keys at https://alpaca.markets/ (paper keys are free).

# --- Paper (simulated) sandbox keys — safe, fake money ---
BJC_PAPER_API_KEY=
BJC_PAPER_SECRET=

# --- Live (REAL money) keys ---
# IMPORTANT: generate these as TRADING-ONLY keys with NO withdrawal/banking scope.
BJC_LIVE_API_KEY=
BJC_LIVE_SECRET=

# Live trading is OFF unless this is explicitly "true" AND live keys are present.
BJC_LIVE_TRADING_ENABLED=false

# Dry-run is ON by default. While true, `approve` prints "WOULD submit" and sends nothing.
BJC_DRY_RUN=true

# --- Risk guardrails (all required, must be > 0) ---
BJC_MAX_TRADE_NOTIONAL=100      # max USD per single order
BJC_MAX_POSITION_PCT=20         # max % of account equity in one position
BJC_MAX_OPEN_POSITIONS=5        # max simultaneous open positions
BJC_MAX_DAILY_LOSS=50           # USD daily loss vs start-of-day equity -> kill switch

# --- Storage ---
BJC_DB_PATH=./bjc.db
